# 9router-go environment contract
# Copy to .env and fill in values.

# ==============================================================================
# Container / GHCR Image (for docker-compose.yml & docker-stack.yml)
# ==============================================================================
# GHCR_IMAGE=ghcr.io/natan-m64/9router-go
# IMAGE_TAG=latest

# ==============================================================================
# Server & Network
# ==============================================================================
PORT=20130
HOST=0.0.0.0
# TZ=UTC

# ==============================================================================
# Storage & Database
# ==============================================================================
DATA_DIR=/data
# DB_PATH=/data/db/data.sqlite
# DATABASE_URL=postgres://router:change-me@db:5432/router?sslmode=disable
# DB_MAX_CONNS=50
# DB_MAX_IDLE_CONNS=10

# ==============================================================================
# Security & Auth (Recommended in production)
# ==============================================================================
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
# Master key for encrypting stored provider credentials in the vault (32 bytes: hex/base64, e.g. `openssl rand -hex 32`).
# ROUTER_MASTER_KEY=
# API_KEY_SECRET=change-me-api-key-secret
# MACHINE_ID_SALT=change-me-machine-salt

# ==============================================================================
# Token Saver & Prompt Features
# ==============================================================================
RTK_ENABLED=true
CAVEMAN_ENABLED=false
PONYTAIL_ENABLED=false
ADHD_ENABLED=false
INJECTION_GUARD_DISABLED=false

# ==============================================================================
# Routing & Resilience
# ==============================================================================
# When every account of a provider is in cooldown, serve the request through
# the account that frees up first instead of failing.
# FORCE_FALLBACK_ON_ALL_UNAVAILABLE=true

# Set to true or 1 to forbid the insecure-TLS retry.
# STRICT_SSL=true

# Private/LAN upstreams (default: true). Set to false to restore strict SSRF refusal.
# ALLOW_PRIVATE_NETWORKING=false

# Per-seat attempt timeout budget in milliseconds (0 = disabled).
# SEAT_ATTEMPT_BUDGET_MS=0

# Set to off to stream Kiro tool fragments as they arrive instead of buffering.
# KIRO_INTEGRITY_GATE=off

# ==============================================================================
# Runtime & Observability
# ==============================================================================
AUTO_UPDATE=false
# LOG_FILE=
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=9router-go

# ==============================================================================
# Outbound Proxy (optional)
# ==============================================================================
# HTTP_PROXY=
# HTTPS_PROXY=
# ALL_PROXY=
# NO_PROXY=

# ==============================================================================
# OAuth Client Credentials (optional overrides)
# ==============================================================================
# Set these only to override built-in defaults for public OAuth clients.
# ANTIGRAVITY_OAUTH_CLIENT_ID=
# ANTIGRAVITY_OAUTH_CLIENT_SECRET=
# GEMINI_CLI_OAUTH_CLIENT_ID=
# GEMINI_CLI_OAUTH_CLIENT_SECRET=
# XAI_OAUTH_CLIENT_ID=
# XAI_OAUTH_CLIENT_SECRET=
# CODEX_OAUTH_CLIENT_ID=
# CODEX_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# IFLOW_OAUTH_CLIENT_ID=
# IFLOW_OAUTH_CLIENT_SECRET=
# KIMI_CODING_OAUTH_CLIENT_ID=
# KIMI_CODING_OAUTH_CLIENT_SECRET=
# QWEN_OAUTH_CLIENT_ID=
# QWEN_OAUTH_CLIENT_SECRET=
# QODER_OAUTH_CLIENT_ID=
# QODER_OAUTH_CLIENT_SECRET=
