# 9router-go minimal bootstrap environment contract
# Copy to .env and fill in values.
# Operational settings (Token Savers, Routing, Fallback, Observability, etc.)
# are persisted in the database and managed via the Dashboard UI.

# Container / GHCR Image (for docker-compose.yml & docker-stack.yml)
# GHCR_IMAGE=ghcr.io/natan-m64/9router-go
# IMAGE_TAG=latest

# Server & Network
PORT=20130
HOST=0.0.0.0
# TZ=UTC

# Storage & Database (SQLite by default; set DATABASE_URL for PostgreSQL)
DATA_DIR=/data
# DB_PATH=/data/db/data.sqlite
# DATABASE_URL=postgres://router:change-me@db:5432/router?sslmode=disable
# DB_MAX_CONNS=50
# DB_MAX_IDLE_CONNS=10

# Security & Auth (generate secrets with: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
# ROUTER_MASTER_KEY=

# Container runtime
AUTO_UPDATE=false

# Request body ceiling for the JSON APIs (/v1/responses, /v1/chat/completions,
# ...), in whole MiB from 1 to 1024. Default 10. Long Codex / Claude Code
# sessions with images or large tool outputs can exceed it; raise to 32, 64,
# 128 or 256. Each in-flight request may buffer up to this much memory. An
# invalid value fails startup. Media uploads (video, transcription) keep their
# own 128 MiB ceiling unless this is set higher.
# MAX_JSON_BODY_SIZE_MB=64

# OAuth client credentials
# Set these to override built-in defaults. Hardcoded fallbacks exist for
# well-known public clients (antigravity, gemini-cli, xai, codex, iflow, etc.)
# so most users don't need to touch these.
# ANTIGRAVITY_OAUTH_CLIENT_ID=
# ANTIGRAVITY_OAUTH_CLIENT_SECRET=
# GEMINI_CLI_OAUTH_CLIENT_ID=
# GEMINI_CLI_OAUTH_CLIENT_SECRET=
# XAI_OAUTH_CLIENT_ID=
# XAI_OAUTH_CLIENT_SECRET=
# CODEX_OAUTH_CLIENT_ID=
# CODEX_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# IFLOW_OAUTH_CLIENT_ID=
# IFLOW_OAUTH_CLIENT_SECRET=
# KIMI_CODING_OAUTH_CLIENT_ID=
# KIMI_CODING_OAUTH_CLIENT_SECRET=
# QWEN_OAUTH_CLIENT_ID=
# QWEN_OAUTH_CLIENT_SECRET=
# QODER_OAUTH_CLIENT_ID=
# QODER_OAUTH_CLIENT_SECRET=

# Outbound proxy (optional)
# HTTP_PROXY=
# HTTPS_PROXY=

# When every account of a provider is in cooldown, serve the request through
# the account that frees up first instead of failing. Same effect as the
# "Force Fallback" toggle in Settings -> Default Routing Strategy; upstream parity.
# FORCE_FALLBACK_ON_ALL_UNAVAILABLE=true

# Set to true or 1 to forbid the insecure-TLS retry. By default a request that
# fails certificate verification is replayed once with verification disabled,
# which is what gets through a corporate proxy or antivirus that re-signs TLS.
# STRICT_SSL=true

# Private/LAN upstreams (default: on). A self-hosted or LAN provider (ollama on
# loopback, a second gateway on the LAN, a Tailscale peer) is a normal
# deployment, so the SSRF guard does not refuse it. Set to false to restore the
# strict refusal: private/reserved targets are refused unless a request carries
# the per-connection opt-in. While this is on, the dial-time socket guard is
# skipped entirely, so it refuses no address class on any dial — including
# cloud-metadata and DNS-rebinding targets.
# ALLOW_PRIVATE_NETWORKING=false

# Kiro buffers a whole turn before it emits a tool call, because the upstream
# fragments one call across frames and the arguments are only complete at end
# of stream. Set to off to stream tool fragments as they arrive instead, which
# trades complete reassembly for lower latency.
# KIRO_INTEGRITY_GATE=off
